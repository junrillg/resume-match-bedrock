# Synthetic example only: confirm your account, DNS zone, AZs, model access and versions.
account_id              = "111122223333"
region                  = "us-east-1"
availability_zones      = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_zone_id          = "Z0123456789EXAMPLE"
hostname                = "resume.example.com"
postgres_engine_version = "17.11"
bedrock_model_id         = "example.model-v1:0"
bedrock_resource_arns    = ["arn:aws:bedrock:us-east-1::foundation-model/example.model-v1:0"]

# Project retention policy; application expiry runs before eventual S3 lifecycle cleanup.
document_retention_days = 90

# Phase 1: foundation only. No placeholder task definition or image is deployed.
image_digests       = null
bootstrap_completed = false
enable_services     = false
# Phase 2: set image_digests = { api = "sha256:<actual digest>", web = "sha256:<actual digest>" }
# Phase 3: run the one-off bootstrap task; then set both booleans true after exit code 0.

# Small initial profile; same event architecture supports larger reviewed inputs.
# service_capacity, gateway_connections, fanout_shards and capacity_limits are validated.
# These do not certify throughput or account quotas. Peak100 comparisons/s is a planning input.
admission_rate_per_second = 2
admission_max_active = 32
owner_active_job_limit = 2
queue_age_limit_seconds = 60
