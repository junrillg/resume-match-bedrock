#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Purpose: Run the complete local, synthetic-data lab with Docker Compose.
Usage: ./scripts/lab up|down|status|logs|test|credentials|help
  up           Build and start services; create private local secrets once and seed lab login.
  down         Stop this lab; preserve database, originals, signature, broker and log volumes.
  status       Show service health.
  logs         Follow the latest service logs (Ctrl-C stops following).
  test         Run the backend tests against the container database engine.
  credentials  Print the synthetic app and viewer logins; run privately, not in shared logs.
  help|-h|--help  Show usage without checking Docker or touching files.
Requires: Docker with Compose; openssl for first startup/environment upgrades. No cloud calls.
Examples: ./scripts/lab help; ./scripts/lab up; ./scripts/lab status; ./scripts/lab down
EOF
}

action=$(printf '%s' "${1:-help}" | tr '[:upper:]' '[:lower:]')
case "$action" in
  help|-h|--help) usage; exit 0 ;;
  up|down|status|logs|test|credentials) ;;
  *) usage >&2; exit 2 ;;
esac
[ "$#" -eq 1 ] || { usage >&2; exit 2; }
cd "$(CDPATH= cd "$(dirname "$0")/.." && pwd)"
command -v docker >/dev/null 2>&1 || { echo 'Docker is required.' >&2; exit 1; }
docker info --format '{{.ServerVersion}}' >/dev/null

if [ "$action" = up ]; then
  [ ! -L .env ] || { echo '.env must be an owner-managed regular file, not a symlink.' >&2; exit 1; }
  if [ -e .env ]; then
    [ -f .env ] && [ "$(ls -nd .env | awk '{print $3}')" = "$(id -u)" ] || {
      echo '.env must be a regular file owned by the current user.' >&2; exit 1;
    }
    chmod 600 .env
  fi
  needs_upgrade=false
  for key in OPENOBSERVE_PASSWORD OBJECT_ADMIN_ACCESS_KEY OBJECT_ADMIN_SECRET_KEY OBJECT_API_ACCESS_KEY OBJECT_API_SECRET_KEY OBJECT_WORKER_ACCESS_KEY OBJECT_WORKER_SECRET_KEY OBJECT_RELAY_ACCESS_KEY OBJECT_RELAY_SECRET_KEY FLOWER_PASSWORD FLOWER_BROKER_PASSWORD RABBITMQ_VIEWER_PASSWORD POSTGRES_VIEWER_PASSWORD PGADMIN_PASSWORD STORAGE_VIEWER_PASSWORD STORAGE_ADMIN_PASSWORD STREAM_GATEWAY_PASSWORD STREAM_RELAY_PASSWORD STREAM_VIEWER_PASSWORD STREAM_GUI_PASSWORD; do
    if [ ! -e .env ] || ! grep -q "^$key=" .env; then needs_upgrade=true; fi
  done
  if [ "$needs_upgrade" = true ]; then
    command -v openssl >/dev/null 2>&1 || { echo 'Install openssl before local environment setup.' >&2; exit 1; }
    umask 077
    pending=$(mktemp .env.init.XXXXXX)
    trap 'rm -f "$pending"' EXIT HUP INT TERM
    original=""
    if [ -e .env ]; then
      original=$(cksum .env)
      cat .env > "$pending"
      printf '\n' >> "$pending"
    else
      {
        printf 'POSTGRES_DB=resume_match\nPOSTGRES_USER=lab\n'
        for key in POSTGRES_PASSWORD RABBITMQ_PASSWORD DJANGO_SECRET_KEY LAB_DEMO_PASSWORD; do
          value=$(openssl rand -hex 32)
          printf '%s=%s\n' "$key" "$value"
        done
      } > "$pending"
    fi
    if ! grep -q '^OPENOBSERVE_PASSWORD=' "$pending"; then
      value=$(openssl rand -hex 32)
      printf 'OPENOBSERVE_PASSWORD=Aa1!%s\n' "$value" >> "$pending"
    fi
    for key in OBJECT_ADMIN_ACCESS_KEY OBJECT_ADMIN_SECRET_KEY OBJECT_API_ACCESS_KEY OBJECT_API_SECRET_KEY OBJECT_WORKER_ACCESS_KEY OBJECT_WORKER_SECRET_KEY OBJECT_RELAY_ACCESS_KEY OBJECT_RELAY_SECRET_KEY FLOWER_PASSWORD FLOWER_BROKER_PASSWORD RABBITMQ_VIEWER_PASSWORD POSTGRES_VIEWER_PASSWORD PGADMIN_PASSWORD STORAGE_VIEWER_PASSWORD STORAGE_ADMIN_PASSWORD STREAM_GATEWAY_PASSWORD STREAM_RELAY_PASSWORD STREAM_VIEWER_PASSWORD STREAM_GUI_PASSWORD; do
      if ! grep -q "^$key=" "$pending"; then
        value=$(openssl rand -hex 32)
        printf '%s=%s\n' "$key" "$value" >> "$pending"
      fi
    done
    if [ -n "$original" ]; then
      [ -f .env ] && [ "$original" = "$(cksum .env)" ] || { echo 'Local environment changed; retry up.' >&2; exit 1; }
      mv "$pending" .env
    else
      ln "$pending" .env || { echo 'Local environment changed; retry up.' >&2; exit 1; }
      rm "$pending"
    fi
    trap - EXIT HUP INT TERM
  fi
fi

case "$action" in
  up)
    docker compose config --quiet
    COMPOSE_PARALLEL_LIMIT=1 docker compose build
    docker compose up -d --wait --wait-timeout 900
    docker compose exec -T api python manage.py ensure_lab_user
    printf 'Lab ready: http://127.0.0.1:8088/\nLogs: http://127.0.0.1:5080/\nBroker: http://127.0.0.1:15672/\nTasks: http://127.0.0.1:5555/tasks\nDatabase: http://127.0.0.1:5050/\nObjects: http://127.0.0.1:23646/files?path=/buckets/resume-originals\nFan-out: http://127.0.0.1:8089/\nScanner: docker compose exec scanner clamdtop\nRun ./scripts/lab credentials privately for the local logins.\n'
    ;;
  down) docker compose down ;;
  status) docker compose ps ;;
  logs) docker compose logs --tail=100 --follow ;;
  test) docker compose exec -T api python manage.py test matching ;;
  credentials)
    [ -f .env ] && [ ! -L .env ] || { echo 'Run ./scripts/lab up first.' >&2; exit 1; }
    awk -F= '
      BEGIN {
        labels["LAB_DEMO_PASSWORD"]="App username: lab\nApp password: "
        labels["OPENOBSERVE_PASSWORD"]="Log viewer email: lab@example.invalid\nLog viewer password: "
        labels["RABBITMQ_VIEWER_PASSWORD"]="Broker username: lab_monitor\nBroker password: "
        labels["FLOWER_PASSWORD"]="Tasks username: viewer\nTasks password: "
        labels["PGADMIN_PASSWORD"]="Database GUI email: lab@example.invalid\nDatabase GUI password: "
        labels["STREAM_GUI_PASSWORD"]="Fan-out GUI username: viewer\nFan-out GUI password: "
        labels["STORAGE_VIEWER_PASSWORD"]="Storage username: viewer\nStorage password: "
      }
      $1 in labels { print labels[$1] substr($0, index($0, "=")+1) }
    ' .env
    ;;
esac
