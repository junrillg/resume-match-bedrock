# Reference only: run ./scripts/lab up to generate the ignored owner-only .env.
# Do not copy this file over an initialized environment or named volumes.
POSTGRES_DB=resume_match
POSTGRES_USER=lab
# Generated random values, never committed:
# POSTGRES_PASSWORD: PostgreSQL bootstrap credential
# RABBITMQ_PASSWORD: RabbitMQ bootstrap credential
# DJANGO_SECRET_KEY: Django sessions/CSRF signing secret
# LAB_DEMO_PASSWORD: synthetic app login (username lab)
# OPENOBSERVE_PASSWORD: local log viewer login (email lab@example.invalid)
# OBJECT_ADMIN_ACCESS_KEY / OBJECT_ADMIN_SECRET_KEY: storage initializer only
# OBJECT_API_ACCESS_KEY / OBJECT_API_SECRET_KEY: local original read/write
# OBJECT_WORKER_ACCESS_KEY / OBJECT_WORKER_SECRET_KEY: local original reads
# OBJECT_RELAY_ACCESS_KEY / OBJECT_RELAY_SECRET_KEY: local original cleanup
# FLOWER_PASSWORD: read-only task GUI (username viewer)
# FLOWER_BROKER_PASSWORD: isolated task-event subscriber, not a browser login
# RABBITMQ_VIEWER_PASSWORD: monitoring-only broker GUI (username lab_monitor)
# POSTGRES_VIEWER_PASSWORD: SELECT-only database role, preconfigured in pgAdmin
# PGADMIN_PASSWORD: local database GUI (email lab@example.invalid)
# STORAGE_VIEWER_PASSWORD: read-only cluster operator GUI (username viewer)
# STORAGE_ADMIN_PASSWORD: internal storage console administrator, not the viewing login
