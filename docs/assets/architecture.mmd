flowchart LR
  U["React review workbench<br/>Synthetic résumé + weighted requirements"]
  A["Django API<br/>Session auth · CSRF · owner scope"]
  P["Bounded parser<br/>PDF / UTF-8 TXT / pasted text"]
  D["Local demo<br/>Literal evidence extraction"]
  B["AWS Bedrock Converse<br/>Opt-in external boundary"]
  V["Validate evidence<br/>Schema + source quote + skill mention"]
  S["Deterministic score<br/>Matched weight / total weight"]
  DB[("SQLite local<br/>Owner-scoped results + quota counters")]
  U --> A --> P
  P -->|default| D
  P -.->|explicit configuration| B
  D --> V
  B -.-> V
  V --> S --> DB
  S -->|Score + evidence| U
